# Public site URL (used for canonical URLs, sitemap and OG images)
NEXT_PUBLIC_SITE_URL=https://edgetechnical.ng

# WhatsApp number in international format, digits only (no +), e.g. 2348102301860
NEXT_PUBLIC_WHATSAPP_NUMBER=2348102301860

# Analytics (optional). Plausible domain, e.g. edgetechnical.ng — cookieless, no banner needed.
NEXT_PUBLIC_ANALYTICS_ID=
# NEXT_PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.js

# Contact form email (Resend). Without RESEND_API_KEY, submissions are logged to the server console.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender on a domain verified in Resend
CONTACT_FROM_EMAIL="Edgetechnical Website <website@edgetechnical.ng>"
